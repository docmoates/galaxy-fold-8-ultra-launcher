<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!-- Uninstall context action (ACTION_DELETE on a package: URI) needs this on targetSdk 28+. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- Hosting app widgets. BIND_APPWIDGET is signature|privileged, so a sideloaded launcher is not
         granted it; the real grant comes from the ACTION_APPWIDGET_BIND dialog the host shows once
         per app (the system persists the user's choice per package). Declaring it matches Launcher3. -->
    <uses-permission android:name="android.permission.BIND_APPWIDGET"
        tools:ignore="ProtectedPermissions" />
    <!-- Built-in widgets: Calendar agenda (events), Photos (frame), Devices battery (Watch / Buds over
         Bluetooth). Each is requested at runtime from the widget's own "Allow ..." button. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!-- Android 14 "Select photos": partial access is granted as this permission while
         READ_MEDIA_IMAGES stays denied; the Photos widget accepts either. -->
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Phase 4+5. Hub > Today / Contacts and universal search read contacts and the call log
         (runtime, requested from the "Allow" cards). -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <!-- Gestures: StatusBarManager.expandNotificationsPanel / expandSettingsPanel (normal). -->
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />
    <!-- Profiles: re-arm the schedule alarm after a reboot (ProfileBootReceiver) and switch on the
         minute when the user grants "Alarms & reminders" (ProfileScheduler). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Mail: Gmail API over HTTPS (GmailApiClient, AppAuth token exchange) and the Gmail app's
         public label-count provider (normal permission, no sign-in). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Daily wallpaper (Settings > Look, off by default): WallpaperManager.setBitmap. Normal permission. -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <uses-permission android:name="com.google.android.gm.permission.READ_CONTENT_PROVIDER" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- App widget providers (QUERY_ALL_PACKAGES already covers them; belt and braces). -->
        <intent>
            <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        </intent>
        <!-- Icon packs advertise themselves through these theme intents (icons/IconPackLoader). -->
        <intent>
            <action android:name="org.adw.launcher.THEMES" />
        </intent>
        <intent>
            <action android:name="com.novalauncher.THEME" />
        </intent>
        <intent>
            <action android:name="com.anddoes.launcher.THEME" />
        </intent>
        <intent>
            <action android:name="com.teslacoilsw.launcher.THEME" />
        </intent>
        <!-- Phase 4+5: the Gmail app (label counts, open thread / compose intents), Google Lens
             (visual search button) and AICore (on-device AI engine check). -->
        <package android:name="com.google.android.gm" />
        <package android:name="com.google.ar.lens" />
        <package android:name="com.google.android.aicore" />
        <!-- Universal search opens web results and the AI tab starts speech recognition. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
        <!-- AppAuth (Gmail sign-in) looks for Custom Tabs providers. -->
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
    </queries>

    <application
        android:name=".core.FoldOsApplication"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.FoldOS">

        <!-- configChanges keeps fold / unfold from recreating the activity while the app-widget bind
             or configure dialogs are open; their results arrive in MainActivity.onActivityResult. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:resizeableActivity="true"
            android:clearTaskOnLaunch="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|uiMode|density"
            android:windowSoftInputMode="adjustNothing"
            android:theme="@style/Theme.FoldOS">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- The home activity never shows in app lists, so Settings carries the launcher icon
             ("FoldOS") and offers "Set as default home" when opened. -->
        <activity
            android:name=".settings.SettingsActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.FoldOS">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Setup wizard re-run and the preset gallery (Settings > Quick setup); the first-run wizard
             itself is drawn inside MainActivity. -->
        <activity
            android:name=".onboarding.OnboardingActivity"
            android:exported="false"
            android:theme="@style/Theme.FoldOS" />

        <!-- Hub > Mail: Google sign-in through AppAuth. The OAuth redirect
             "com.foldos.launcher:/oauth2redirect" is caught by AppAuth's RedirectUriReceiverActivity,
             declared in the library manifest through the appAuthRedirectScheme placeholder. -->
        <activity
            android:name=".mail.MailAuthActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|uiMode|density"
            android:theme="@style/Theme.FoldOS" />

        <!-- Profiles: boundary alarm (only our own PendingIntent targets it) and the re-arm receiver
             for boot, app update, clock / time-zone changes and the exact-alarm grant. -->
        <receiver
            android:name=".profiles.ProfileAlarmReceiver"
            android:exported="false" />
        <receiver
            android:name=".profiles.ProfileBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Daily wallpaper: the daily alarm (our own PendingIntent) and re-arm after boot, app update,
             clock or time-zone change. -->
        <receiver
            android:name=".wallpaper.DailyWallpaperReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Notification access unlocks MediaSessionManager.getActiveSessions for the Now Playing
             widget and feeds notification badges, long-press previews and the quiet drawer
             (notifications.ActiveNotifications). Granted by the user under Settings > Notifications >
             Device & app notifications. -->
        <service
            android:name=".builtins.FoldOsNotificationListener"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

    </application>

</manifest>
