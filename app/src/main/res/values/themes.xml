<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Platform theme used before Compose takes over. Compose Material 3 draws the real UI.
         System bar colors are owned by enableEdgeToEdge() in the activities. -->
    <style name="Theme.FoldOS" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
